{
  // Cloudflare Workers: the static site (dist/) plus a small Worker for the form endpoint and the admin CRM.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "admonk",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Only these paths reach the Worker; everything else is served straight from dist/.
    "run_worker_first": ["/api/*", "/admin", "/admin/*"]
  },
  "d1_databases": [{ "binding": "DB", "database_name": "admonk-crm", "database_id": "8f2283fa-e229-4971-bf01-caf10bd978cf", "migrations_dir": "migrations" }],
  // New enquiries are emailed to info@admonk.net once this is switched on. The address must first be
  // verified in Cloudflare Email Routing, or the deploy fails. Until then enquiries are only saved.
  // "send_email": [{ "name": "NOTIFY", "destination_address": "info@admonk.net" }],
  "vars": {
    "NOTIFY_FROM": "website@admonk.net",
    // Admin dashboard. Google accounts listed here become owners the first time they sign in;
    // everyone else is invited from Admin → Members. Secrets (set in the Cloudflare dashboard, not here):
    // GOOGLE_CLIENT_SECRET (Google sign-in) and GITHUB_TOKEN (content editing).
    "OWNER_EMAILS": "info@admonk.net",
    // The OAuth client ID isn't secret; keeping it here stops deploys from wiping it.
    "GOOGLE_CLIENT_ID": "960644797619-jttojqjhns7hrdtm1qdfqg18e816aa1t.apps.googleusercontent.com",
    "GITHUB_REPO": "admonkstudio/admonk",
    "CONTENT_BRANCH": "main"
  },
  "observability": { "enabled": true }
}
