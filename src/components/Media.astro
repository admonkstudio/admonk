---
// Shows a content image. Local files (src/assets/cms) are resized and served as AVIF/WebP;
// a remote URL (not yet copied into the repo) is shown as is.
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src: string | ImageMetadata;
  alt: string;
  class?: string;
  widths?: number[];
  sizes?: string;
  eager?: boolean;
  style?: string;
}
const { src, alt, widths = [480, 800, 1200, 1600], sizes = '(min-width: 80rem) 40rem, 100vw', eager, ...rest } = Astro.props;
const loading = eager ? 'eager' : 'lazy';
const isSvg = typeof src !== 'string' && src.format === 'svg';
---
{typeof src === 'string' || isSvg
  ? <img src={typeof src === 'string' ? src : src.src} alt={alt} loading={loading} decoding="async" {...rest} />
  : <Picture src={src} alt={alt} formats={['avif', 'webp']} fallbackFormat="jpg" quality="mid" widths={widths.filter((w) => w <= src.width).concat(widths.some((w) => w <= src.width) ? [] : [src.width])} sizes={sizes} loading={loading} decoding="async" {...rest} />}
