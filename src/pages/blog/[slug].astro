---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { href, live, resolve } from '../../lib/site';
export async function getStaticPaths() {
  return (await live('blog')).map((e) => ({ params: { slug: e.id }, props: { e } }));
}
const { e } = Astro.props;
const d = e.data;
const { Content } = await render(e);
const tools = await resolve(d.tools);
const date = (x: Date) => x.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title={d.title.length <= 50 ? `${d.title} | Admonk` : d.title} description={d.description}
  jsonLd={{ '@context': 'https://schema.org', '@type': 'BlogPosting', headline: d.title, description: d.description, datePublished: d.published.toISOString(), dateModified: (d.updated ?? d.published).toISOString(), author: { '@type': 'Organization', name: 'Admonk' }, publisher: { '@type': 'Organization', name: 'Admonk' } }}>
  <article>
    <section class="hero">
      <div class="shell head">
        <p class="eyebrow"><a href="/blog">Blog</a> · {date(d.published)}</p>
        <h1>{d.title}</h1>
        <p class="lead">{d.description}</p>
      </div>
    </section>
    <section class="top">
      <div class="shell prose"><Content /></div>
    </section>
  </article>
  {tools.length > 0 && (
    <section>
      <div class="shell"><p class="eyebrow">Tools in this post</p><ul class="tags">{tools.map((t) => <li><a href={href(t)}>{t.data.name}</a></li>)}</ul></div>
    </section>
  )}
</Base>
