{
  "name": "admonk-website",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --port 4321",
    "build": "node scripts/check-refs.mjs && astro build && node scripts/webflow-port.mjs",
    "preview": "astro preview --port 4321",
    "check": "astro check",
    "import:webflow": "node scripts/import-webflow.mjs",
    "dev:worker": "npm run build && wrangler dev",
    "deploy": "wrangler d1 migrations apply admonk-crm --remote && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.2.2",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.6",
    "cheerio": "^1.0.0",
    "jquery": "^3.5.1",
    "marked": "^15.0.12",
    "pagefind": "1.3.0",
    "typescript": "5.9.3",
    "wrangler": "^4.160.0",
    "yaml": "^2.9.1"
  }
}
